# Reddit connector — PRAW app creds give scores/comments/selftext.
# Optional: without them the connector falls back to the keyless search.rss
# feed (engagement counts come back zero, but it works with no signup).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=pulsetrace/0.2

# YouTube connector — no API key. Requires the `yt-dlp` binary on PATH
# (pip install yt-dlp, or your distro package). Returns [] if missing.

# Polymarket connector — no auth. Public Gamma search API, always on.

# GitHub connector — works unauthenticated (10 req/min). Set a token to raise
# the rate limit (30 req/min) and search cap.
GITHUB_TOKEN=

# Bluesky connector (optional — connector returns [] without creds)
# Generate an app password at https://bsky.app/settings/app-passwords
BLUESKY_APP_USERNAME=
BLUESKY_APP_PASSWORD=

# v1 Facebook scraper (optional in v2)
# v2 FacebookConnector reads info/cookies.json instead — leave blank.
FACEBOOK_EMAIL=
FACEBOOK_PASSWORD=

# Twitter / X (optional — connector returns [] without creds)
# Preferred: place exported browser cookies in info/x_cookies.json
X_USERNAME=
X_PASSWORD=
X_EMAIL=

# Instagram (optional — connector returns [] without creds)
# Preferred: place session file at info/ig_session_<username> (instaloader format)
IG_USERNAME=
IG_PASSWORD=

# Backend selection — one of:
#   gemini | ollama | openrouter | groq | pollen | llm7 | huggingface
# Leave unset to use the multi-provider cascade (lib/dispatch.py rotates
# stages across every provider that has a working key — never overruns one
# free-tier quota). Set to a single name to force that provider only.
# PULSETRACE_BACKEND=gemini

# Optional: override embedding backend independently (defaults to chat backend,
# falls back to gemini if the chosen provider has no embedding model).
# PULSETRACE_EMBED_BACKEND=gemini

# Per-provider keys are loaded from `.env.api_keys` (lowercase=value, gitignored).
# Recognized lines there:
#   gemini_paid_api_key=...    # preferred — paid Gemini; wins over free if both set
#   gemini_api_key=...         # free-tier fallback
#   huggingface_token=...
#   openrouter_api_key=...
#   ollama_api_key=...         # only needed for hosted ollama.com cloud
#   groq_api_key=...
#   pollen_api_key=...
#   LLM7_api_key=...

# Optional model overrides per provider:
# GEMINI_CHAT_MODEL=gemini-2.5-flash-lite
# GEMINI_EMBED_MODEL=gemini-embedding-001
# GEMINI_VISION_MODEL=gemini-2.5-flash
# OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
# GROQ_CHAT_MODEL=llama-3.3-70b-versatile
# POLLEN_CHAT_MODEL=openai
# LLM7_CHAT_MODEL=gpt-4o-mini-2024-07-18
# HF_CHAT_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Ollama settings (only used when PULSETRACE_BACKEND=ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_TIMEOUT=600
OLLAMA_EMBED_TIMEOUT=300

# /docs admin token — gates /docs/admin form. Change in production.
DOCS_ADMIN_TOKEN=pulsetrace-admin

# === Tiered storage (optional) — db/ package ==========================
# All blank/unset => storage stays file-based (data/runs/<id>/ + FAISS).
# Set the URIs below to mirror runs/posts/clusters/artifacts into Postgres
# (pgvector) + MongoDB. Clients self-load this .env; no code change needed.

# --- Supabase / Postgres + pgvector ---
# Direct host is IPv6-only; prefer the Supavisor pooler (IPv4) connection
# string from: Supabase Dashboard > Project Settings > Database.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# SUPABASE_URL=https://<ref>.supabase.co
# PULSE_EMBED_DIM=3072          # embedding dim => halfvec(N) in schema.sql
# PG_POOL_MIN=1                 # psycopg2 ThreadedConnectionPool min
# PG_POOL_MAX=8                 # ...max
#
# --- Authenticated REST channel (db/supabase_auth.py) ---
# Signs a Supabase Auth user in so REST calls run as the `authenticated` role
# under your RLS policies. Separate from DATABASE_URL (which is the postgres
# role and bypasses RLS). All four required to enable; otherwise disabled.
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...   # Dashboard > API Keys (or SUPABASE_ANON_KEY)
# SUPABASE_AUTH_EMAIL=dev@example.com
# SUPABASE_AUTH_PASSWORD=...

# --- MongoDB hot/cold tiering ---
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB=pulsetrace
# MONGODB_MAX_POOL=20           # pool ceiling (long-running OLTP server)
# MONGODB_MIN_POOL=2            # pre-warmed connections
# PULSE_HOT_TTL_DAYS=45         # TTL backstop on hot collection
# PULSE_ARCHIVE_AGE_DAYS=14     # hot->cold archival window (< TTL)

# Orchestration layer (lib/orchestration) — LangGraph + n8n knobs.
AGENT_MAX_RETRIES=3
AGENT_RETRY_BACKOFF_SECS=30
AGENT_ENGAGEMENT_THRESHOLD=0.75
# Squash constant: raw influence -> (0,1) via 1 - exp(-raw/SCALE). Higher = stricter alerts.
AGENT_ENGAGEMENT_SQUASH_SCALE=3.0
N8N_WEBHOOK_BASE_URL=http://localhost:5678
N8N_RECRAWL_CRON=0 */6 * * *
