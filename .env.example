# Required for Reddit connector
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=pulsetrace/0.2

# v1 Facebook scraper (optional in v2)
# v2 FacebookConnector reads info/cookies.json instead — leave blank.
FACEBOOK_EMAIL=
FACEBOOK_PASSWORD=

# Twitter / X (optional — connector returns [] without creds)
# Preferred: place exported browser cookies in info/x_cookies.json
X_USERNAME=
X_PASSWORD=
X_EMAIL=

# Instagram (optional — connector returns [] without creds)
# Preferred: place session file at info/ig_session_<username> (instaloader format)
IG_USERNAME=
IG_PASSWORD=

# Backend selection — one of:
#   gemini | ollama | openrouter | groq | pollen | llm7 | huggingface
# Leave unset to use the multi-provider cascade (lib/dispatch.py rotates
# stages across every provider that has a working key — never overruns one
# free-tier quota). Set to a single name to force that provider only.
# PULSETRACE_BACKEND=gemini

# Optional: override embedding backend independently (defaults to chat backend,
# falls back to gemini if the chosen provider has no embedding model).
# PULSETRACE_EMBED_BACKEND=gemini

# Per-provider keys are loaded from `.env.api_keys` (lowercase=value, gitignored).
# Recognized lines there:
#   gemini_paid_api_key=...    # preferred — paid Gemini; wins over free if both set
#   gemini_api_key=...         # free-tier fallback
#   huggingface_token=...
#   openrouter_api_key=...
#   ollama_api_key=...         # only needed for hosted ollama.com cloud
#   groq_api_key=...
#   pollen_api_key=...
#   LLM7_api_key=...

# Optional model overrides per provider:
# GEMINI_CHAT_MODEL=gemini-2.5-flash-lite
# GEMINI_EMBED_MODEL=gemini-embedding-001
# GEMINI_VISION_MODEL=gemini-2.5-flash
# OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
# GROQ_CHAT_MODEL=llama-3.3-70b-versatile
# POLLEN_CHAT_MODEL=openai
# LLM7_CHAT_MODEL=gpt-4o-mini-2024-07-18
# HF_CHAT_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Ollama settings (only used when PULSETRACE_BACKEND=ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_TIMEOUT=600
OLLAMA_EMBED_TIMEOUT=300
