# Required for v2 agent loop
OPENAI_API_KEY=

# Required for Reddit connector
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=pulsetrace/0.2

# v1 Facebook scraper (optional in v2)
# v2 FacebookConnector reads info/cookies.json instead.
FACEBOOK_EMAIL=shyannafis@gmail.com
FACEBOOK_PASSWORD=Dragonlevel10isawesome

# Twitter / X (optional — connector returns [] without creds)
# Preferred: place exported browser cookies in info/x_cookies.json
X_USERNAME=
X_PASSWORD=
X_EMAIL=

# Instagram (optional — connector returns [] without creds)
# Preferred: place session file at info/ig_session_<username> (instaloader format)
IG_USERNAME=
IG_PASSWORD=

# Optional model override (OpenAI backend)
PULSETRACE_LLM_MODEL=gpt-4o-mini

# Backend selection — one of:
#   openai | ollama | gemini | openrouter | groq | pollen | llm7 | huggingface
PULSETRACE_BACKEND=openai

# Optional: override embedding backend independently (defaults to chat backend,
# falls back to openai if the chosen provider has no embedding model).
# PULSETRACE_EMBED_BACKEND=openai

# Per-provider keys are loaded from `.env.api_keys` (lowercase=value).
# Recognized lines there:
#   huggingface_token=...
#   gemini_api_key=...
#   openrouter_api_key=...
#   ollama_api_key=...        # only needed for hosted ollama.com cloud
#   groq_api_key=...
#   pollen_api_key=...
#   LLM7_api_key=...

# Optional model overrides per provider:
# GEMINI_CHAT_MODEL=gemini-2.0-flash
# OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
# GROQ_CHAT_MODEL=llama-3.3-70b-versatile
# POLLEN_CHAT_MODEL=openai
# LLM7_CHAT_MODEL=gpt-4o-mini-2024-07-18
# HF_CHAT_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Ollama settings (only used when PULSETRACE_BACKEND=ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_TIMEOUT=600
OLLAMA_EMBED_TIMEOUT=300
